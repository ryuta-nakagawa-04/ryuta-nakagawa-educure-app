<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jp.educure.household_account_book_app.repository.mapper.CategoryMapper">

  <!-- DB列名 → Categoryフィールドの対応表 -->
  <resultMap id="CatMap" type="jp.educure.household_account_book_app.entity.Category">
    <id     property="id"        column="id"/>
    <result property="userId"    column="user_id"/>
    <result property="name"      column="name"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
  </resultMap>

  <!-- 一覧（ユーザーのカテゴリ全部） -->
  <select id="findAllByUserId" parameterType="int" resultMap="CatMap">
    SELECT id, user_id, name, created_at, updated_at
      FROM categories
     WHERE user_id = #{userId}
     ORDER BY id ASC
  </select>

  <!-- カテゴリ追加 -->
  <insert id="insert"
          parameterType="jp.educure.household_account_book_app.entity.Category"
          useGeneratedKeys="true" keyProperty="id" keyColumn="id">
    INSERT INTO categories (user_id, name)
    VALUES (#{userId}, #{name})
  </insert>

  <!-- 名称変更 -->
  <update id="updateName" parameterType="map">
    UPDATE categories
       SET name = #{name},
           updated_at = now()
     WHERE id = #{id}
       AND user_id = #{userId}
  </update>

  <!-- 削除 -->
  <delete id="deleteById" parameterType="map">
    DELETE FROM categories
     WHERE id = #{id}
       AND user_id = #{userId}
  </delete>
</mapper>
